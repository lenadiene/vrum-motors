<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0"
    xmlns="https://jakarta.ee/xml/ns/persistence"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
    https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <persistence-unit name="vrumMotorsPU" transaction-type="JTA">
        <jta-data-source>jdbc/vrumMotors</jta-data-source>
        <class>br.com.vrum.model.Usuario</class>
        <class>br.com.vrum.model.Cliente</class>
        <class>br.com.vrum.model.Vendedor</class>
        <class>br.com.vrum.model.Gerente</class>
        <class>br.com.vrum.model.AdminFabrica</class>
        <class>br.com.vrum.model.AdminEmpresa</class>
        <class>br.com.vrum.model.Veiculo</class>
        <class>br.com.vrum.model.Pedido</class>
        <class>br.com.vrum.model.Concessionaria</class>
        <class>br.com.vrum.model.Anexo</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/vrum_motors?useSSL=false&amp;serverTimezone=America/Sao_Paulo&amp;allowPublicKeyRetrieval=true"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <property name="jakarta.persistence.jdbc.password" value="root"/>
            <property name="eclipselink.ddl-generation" value="create-or-extend-tables"/>
            <property name="eclipselink.logging.level" value="WARNING"/>
            <property name="eclipselink.weaving" value="false"/>
        </properties>
    </persistence-unit>

</persistence>